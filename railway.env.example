# =============================================================
# Variables de entorno para Railway
# Configúralas en: Railway UI → tu servicio → Variables
# =============================================================

APP_NAME="FishSpot España"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://TU-APP.railway.app

# --- Base de datos (Railway MySQL plugin) ---
# Railway rellena estas variables automáticamente si usas
# "Add Service → Database → MySQL" y vinculas el servicio.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQL_HOST}}
DB_PORT=${{MySQL.MYSQL_PORT}}
DB_DATABASE=${{MySQL.MYSQL_DATABASE}}
DB_USERNAME=${{MySQL.MYSQL_USER}}
DB_PASSWORD=${{MySQL.MYSQL_PASSWORD}}

# --- Redis (Railway Redis plugin) ---
# Railway rellena REDIS_URL automáticamente si usas
# "Add Service → Database → Redis" y vinculas el servicio.
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_CLIENT=predis

# --- Sesiones, caché y colas (deben usar Redis) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Almacenamiento de imágenes ---
FILESYSTEM_DISK=public

# --- Email (opcional, mantener log si no se configura) ---
MAIL_MAILER=log

# --- APP_KEY ---
# Genera una clave ejecutando en local:
#   php artisan key:generate --show
# y pégala aquí. Si se deja vacía, el entrypoint la genera
# automáticamente (pero cambiará en cada redeploy).
APP_KEY=base64:PEGAR_AQUI_LA_CLAVE
